{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mcp": {
    "Resource": "https://firefly-mcp.peters-elshoff.nl/mcp",
    "Issuer": "https://keycloak.peters-elshoff.nl/realms/home",
    "ResourceMetadataUrl": "https://firefly-mcp.peters-elshoff.nl/.well-known/oauth-protected-resource",
    "ScopesSupported": [
      "openid",
      "profile",
      "firefly-mcp"
    ],
    "RequiredScope": ""
  },
  "Upstream": {
    "Headers": {
      "Authorization": "",
      "X-Firefly-III-Url": "http://firefly:8080"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "mcp-root": {
        "ClusterId": "firefly-mcp",
        "Match": {
          "Path": "/mcp"
        }
      },
      "mcp-sub": {
        "ClusterId": "firefly-mcp",
        "Match": {
          "Path": "/mcp/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "firefly-mcp": {
        "Destinations": {
          "primary": {
            "Address": "http://firefly-mcp:3000/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:10:00"
        }
      }
    }
  }
}
